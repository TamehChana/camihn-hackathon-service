datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Volunteer {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String
  refCode   String   @unique
  teams     Team[]
  createdAt DateTime @default(now())

  @@index([refCode])
}

model Team {
  id           String        @id @default(cuid())
  teamName     String
  institution  String?
  leadName     String
  leadEmail    String
  leadPhone    String
  leadRole     String
  status       TeamStatus    @default(PENDING)
  volunteerId  String?
  volunteer    Volunteer?    @relation(fields: [volunteerId], references: [id])
  members      TeamMember[]
  payments     Payment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([leadEmail])
  @@index([volunteerId])
}

model TeamMember {
  id        String   @id @default(cuid())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId    String
  name      String
  email     String
  role      String?
  createdAt DateTime @default(now())

  @@index([teamId])
}

model Payment {
  id             String         @id @default(cuid())
  team           Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId         String
  amount         Int
  currency       String
  provider       String
  providerRef    String
  status         PaymentStatus  @default(INITIATED)
  rawPayload     Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([provider, providerRef])
  @@index([teamId])
}

model ConferenceVolunteer {
  id        String                @id @default(cuid())
  name      String
  email     String
  phone     String
  refCode   String                @unique
  attendees ConferenceAttendee[]
  createdAt DateTime              @default(now())

  @@index([refCode])
}

model ConferenceAttendee {
  id           String                  @id @default(cuid())
  fullName     String
  email        String
  phone        String
  organisation String?
  role         String?
  status       ConferenceAttendeeStatus @default(PENDING)
  volunteerId  String?
  volunteer    ConferenceVolunteer?     @relation(fields: [volunteerId], references: [id])
  payments     ConferencePayment[]
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@index([email])
  @@index([volunteerId])
}

model ConferencePayment {
  id          String        @id @default(cuid())
  attendee    ConferenceAttendee @relation(fields: [attendeeId], references: [id], onDelete: Cascade)
  attendeeId  String
  amount      Int
  currency    String
  provider    String
  providerRef String
  status      PaymentStatus @default(INITIATED)
  rawPayload  Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([provider, providerRef])
  @@index([attendeeId])
}

enum TeamStatus {
  PENDING
  PAID
  CANCELLED
}

enum ConferenceAttendeeStatus {
  PENDING
  PAID
  CANCELLED
}

enum PaymentStatus {
  INITIATED
  SUCCESS
  FAILED
}



